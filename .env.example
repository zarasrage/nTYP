# Copia este archivo a ".env" y completa los valores de tu proyecto Supabase
# (Project Settings > API en app.supabase.com). Son públicas (van al bundle
# del cliente) pero están protegidas por Row Level Security en la base de datos.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Solo se usa en la función serverless (netlify/functions/extract-patient.ts),
# NUNCA se expone al cliente. Configúrala en Netlify: Site settings > Environment variables.
ANTHROPIC_API_KEY=sk-ant-...

# Notificaciones push. Genera el par de claves una sola vez con:
#   npx web-push generate-vapid-keys --json
# VITE_VAPID_PUBLIC_KEY y VAPID_PUBLIC_KEY deben tener el mismo valor (la
# pública). VAPID_PRIVATE_KEY nunca se expone al cliente. VAPID_SUBJECT es un
# "mailto:tu-correo@ejemplo.com" (lo exige el estándar Web Push, no se usa
# para enviar correos).
VITE_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
